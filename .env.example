# Server-only Firebase Admin credentials. Configure these in Vercel; never commit real values.
# Preview verification intentionally runs during the staging build.
# Redeploy marker: verify current Preview environment after credential update.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public Firebase Web API key. This key is designed for browser use; Firebase
# Auth rules and authorized domains remain the security boundary.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Certification stays closed until the English 40+40 banks are genuinely
# validated and the founder explicitly opens the release gate.
CERTIFICATION_ENABLED=false
NEXT_PUBLIC_SITE_URL=https://politangle.org

# Stripe is configured later through Vercel. Never commit real keys.
STRIPE_RESTRICTED_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Checkout remains unavailable until Stripe Tax registrations and settings have
# been reviewed for the launch markets. The standard price is activated only by
# an explicit founder decision; launch is the safe default.
STRIPE_TAX_READY=false
CERTIFICATE_PRICE_STAGE=launch

# Comma-separated Firebase UIDs allowed to open /admin. Prefer Firebase custom
# claim admin=true once the first administrator has been provisioned.
POLITANGLE_ADMIN_UIDS=
